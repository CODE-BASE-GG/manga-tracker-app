# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
# Select which database the API and Prisma CLI use by default.
DATABASE_TARGET=local
# Local PostgreSQL connection.
DATABASE_URL="postgresql://manga_tracker:manga_tracker@localhost:5432/manga_tracker?schema=public"

# Remote PostgreSQL connections. Keep these separate so local development
# never accidentally runs against the remote database.
REMOTE_DATABASE_URL="postgresql://your-user:your-password@your-pooler-host/neondb?sslmode=require"
REMOTE_DIRECT_URL="postgresql://your-user:your-password@your-direct-host/neondb?sslmode=require"

# Port
PORT=3000