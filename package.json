{
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --prefix api run start:dev",
    "dev:web": "npm --prefix web run dev",
    "format": "prettier --write \"api/**/*.{ts,tsx,js,jsx,json,css,md}\" \"web/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"api/**/*.{ts,tsx,js,jsx,json,css,md}\" \"web/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  }
}
