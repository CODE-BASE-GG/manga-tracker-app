{
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --prefix api run start:dev",
    "dev:web": "npm --prefix web run dev",
    "format": "prettier --write \"api/**/*.{ts,tsx,js,jsx,json,css,md}\" \"web/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"api/**/*.{ts,tsx,js,jsx,json,css,md}\" \"web/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6"
  }
}
